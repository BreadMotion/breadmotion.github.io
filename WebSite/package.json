{
  "name": "website",
  "version": "1.0.0",
  "description": "PanKUN Homepage",
  "main": "index.js",
  "scripts": {
    "build:wasm": "node --env-file-if-exists=.env tools/build-wasm.js",
    "build:blog": "node --env-file-if-exists=.env tools/build-blog.js",
    "build:assets": "npm run build:wasm && node --env-file-if-exists=.env tools/build-assets.js",
    "normalize:paths": "node --env-file-if-exists=.env tools/normalize-paths.js",
    "build:static": "node --env-file-if-exists=.env tools/translate-static.js",
    "build:portfolio": "node --env-file-if-exists=.env tools/build-portfolio.js",
    "build:sitemap": "node --env-file-if-exists=.env tools/build-sitemap.js",
    "fetch:popular": "node --env-file-if-exists=.env tools/fetch-gsc-data.js",
    "translate:blog": "node --env-file-if-exists=.env tools/auto-translate.js",
    "build:refactor": "node --env-file-if-exists=.env tools/find-unused-css.js",
    "build:all": "npm run build:static && npm run build:blog && npm run build:assets && npm run build:portfolio && npm run build:refactor && npm run build:sitemap && npm run fetch:popular",
    "start:server": "npx live-server ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "googleapis": "^140.0.0",
    "gray-matter": "^4.0.3",
    "marked": "4.0.0"
  },
  "devDependencies": {
    "glob": "^13.0.0",
    "jsdom": "^27.2.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "esbuild": "^0.18.0",
    "csso": "^5.0.0"
  }
}
